{
  "manifest_version": 3,
  "name": "Commercial Mute",
  "version": "1.6.1",
  "description": "Mutes commercial breaks in sports streams. Learns each stream's scoreboard and sound; replays, interviews and the halftime show stay on.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Commercial Mute: click to start/stop on this tab (right-click for debug panel)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-mute": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mute / unmute now (override)"
    },
    "toggle-auto": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause / resume auto-mute"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
